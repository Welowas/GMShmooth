<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<UseWPF>true</UseWPF>
	<DebugType>embedded</DebugType>
	<Product>GMShmooth</Product>
	<VersionPrefix>0.1.0.2</VersionPrefix>
	<Authors>Welowas</Authors>
	<Copyright>Copyright ©  2026, licensed under GPLv3</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="rustybeacch.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GMShmoothCli\GMShmoothCli.csproj" />
  </ItemGroup>

</Project>
